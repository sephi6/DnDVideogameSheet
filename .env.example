# Copia este archivo como .env.local y rellena los dos valores.
# .env.local NO se sube al repositorio.

# Ajustes → Data API → Project URL
VITE_SUPABASE_URL=https://<ref-del-proyecto>.supabase.co

# Ajustes → API Keys → publishable key (empieza por sb_publishable_).
# Es una clave pensada para el navegador: quien protege los datos es RLS.
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
