# Copy this file as .env.local and fill in the two values.
# .env.local is NOT committed. Restart `npm run dev` after creating it.

# Settings → Data API → Project URL
VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# Settings → API Keys → publishable key (starts with sb_publishable_).
# It is a key meant for the browser: the data is protected by RLS.
# NEVER put the service_role / secret key here.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Compatibility: the old name is still read if you prefer it.
# VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Sign-ups. By default (undefined) the sign-in screen does NOT offer
# "Create account": accounts are created from the Supabase dashboard. Set it to
# 'true' only if you want open registration from the app.
# VITE_SIGNUPS_OPEN=false
