// Worker config that serves ARCANA as a static site.
// SPA routing is handled by `not_found_handling`, NOT by a 200-type `_redirects`:
// Workers rejects the `/* /index.html 200` rule (error 10021, "infinite loop").
{
  "name": "dndvideogamesheet",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
